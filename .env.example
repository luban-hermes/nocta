# 夜航 Nocta — nothing here is required.
# Since v0.2 every setting (admin password, AI, public access, monitoring, timezone, S3 backups) is
# configured in the web UI: the setup wizard on first start, then 夜航后台 → 系统设置.
#
# Variables below are still honoured as *defaults* for settings that were never saved in the UI,
# so existing deployments keep working. Uncomment only what you need.

# ADMIN_PASSWORD=            # legacy login password (until a password is set in the UI)
# PUBLIC_MODE=true
# PUBLIC_MONITORS=false
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=
# AI_MODEL=deepseek-chat
# MONITOR_SCHEDULER=true
# MONITOR_RETENTION_DAYS=7
# ALLOW_PRIVATE_MONITORS=true
# TZ=Asia/Shanghai

# operational
# COOKIE_SECURE=             # true behind an HTTPS proxy that does not send X-Forwarded-Proto
# NOCTA_RESET_PASSWORD=1     # start once to clear the admin password and re-run the setup wizard
# SESSION_SECRET=            # auto-generated and stored (encrypted) in the database when unset
# DATABASE_URL=file:/app/data/nocta.db
