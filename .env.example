# ---------- required ----------
# password for 夜航后台 (single admin)
ADMIN_PASSWORD=change-me
# optional: separate secret for signing session cookies (defaults to a hash of ADMIN_PASSWORD)
SESSION_SECRET=

# ---------- access ----------
# true: visitors can browse the navigation without signing in; false: everything requires login
PUBLIC_MODE=true
# true: visitors can also see the 服务监控 tab (hosts and URLs are visible)
PUBLIC_MONITORS=false
# set to true when served over HTTPS behind a proxy that does not send X-Forwarded-Proto
COOKIE_SECURE=

# ---------- database ----------
DATABASE_URL=file:/app/data/nocta.db

# ---------- AI (any OpenAI-compatible Chat Completions API; leave empty for rule-based mode) ----------
# DeepSeek:  AI_BASE_URL=https://api.deepseek.com/v1                         AI_MODEL=deepseek-chat
# 通义千问:  AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   AI_MODEL=qwen-plus
# OpenAI:    AI_BASE_URL=https://api.openai.com/v1                           AI_MODEL=gpt-4o-mini
# Ollama:    AI_BASE_URL=http://host.docker.internal:11434/v1                AI_MODEL=qwen2.5:7b   (no key needed)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ---------- monitoring ----------
MONITOR_SCHEDULER=true
MONITOR_RETENTION_DAYS=7
# allow HTTP monitors to target LAN / private addresses (bookmark fetching is always SSRF-guarded)
ALLOW_PRIVATE_MONITORS=true
